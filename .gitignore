# Datasets and weights are distributed through the Hugging Face Hub, not git.
# The folders are tracked via .gitkeep; their contents are not.
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
output/*
!output/.gitkeep

