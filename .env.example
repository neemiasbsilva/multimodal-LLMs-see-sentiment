# Copy this file to `.env` and fill in your credentials.
#   cp .env.example .env
# The inference/ scripts load it automatically via python-dotenv. The `.env`
# file is gitignored — never commit real keys.

# --- OpenAI — `--mllm openai` (GPT-4o mini) and `--mllm terra` (GPT-6.1 Terra)
#     share this key ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TERRA_MODEL=gpt-6.1-terra

# --- Google Gemini — used by inference/gemini_task1_classify.py and
#     inference/gemini_task2_caption.py ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# --- Dataset images: one folder of {id}.jpg files, or a root holding
#     part1..part6 subdirectories (the cluster layout) ---
IMAGE_DIR=perceptdata
