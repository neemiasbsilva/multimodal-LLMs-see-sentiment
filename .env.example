# Copy this file to `.env` and fill in your credentials.
#   cp .env.example .env
# The inference/ scripts load it automatically via python-dotenv. The `.env`
# file is gitignored — never commit real keys.

# --- OpenAI (GPT-4o mini) — used by inference/openai_task1_classify.py and
#     inference/openai_task2_caption.py ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini — used by inference/gemini_task1_classify.py and
#     inference/gemini_task2_caption.py ---
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# --- Dataset images: root directory containing part1..part6 subdirectories ---
IMAGE_DIR=perceptdata
